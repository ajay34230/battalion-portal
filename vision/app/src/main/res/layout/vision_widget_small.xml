<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg_day">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_aurora" android:scaleType="fitXY" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/widget_logo" android:contentDescription="@null" />
            <TextClock android:id="@+id/widget_clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                android:format12Hour="h:mm" android:format24Hour="HH:mm" android:textColor="#FF00E5FF" android:textSize="20sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Nothing coming up" android:textColor="#FFE6F3FF" android:textSize="13sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/widget_when" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tap to talk" android:textColor="#FF8FA8C4" android:textSize="10sp" android:maxLines="1" />
    </LinearLayout>
</FrameLayout>